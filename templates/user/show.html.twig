{% extends 'base.html.twig' %}

{% block title %}Utilisateur{% endblock %}

{% block body %}

    <h1>Utilisateur</h1>

    <table class="table table-hover text-left">
        <tbody>
        <tr>
            <th>Id</th>
            <td>{{ user.id }}</td>
        </tr>
        <tr>
            <th>Nom</th>
            <td>{{ user.name }}</td>
        </tr>
        <tr>
            <th>Email</th>
            <td>{{ user.email }}</td>
        </tr>
        <tr>
            <th>Rôle(s)</th>
            <td>{{ user.rolesLibelled|join(', ') }}</td>
        </tr>
        </tbody>
    </table>

    <a type="button" class="btn btn-secondary" href="{{ path('app_home') }}">Retour</a>
    <a type="button" class="btn btn-primary"  href="{{ path('app_user_edit', {'id': user.id}) }}">Mettre à jour le profil</a>
    <a type="button" class="btn btn-primary"  href="{{ path('app_user_edit_password', {'id': user.id}) }}">Mettre à jour le mot de passe</a>

{% endblock %}
