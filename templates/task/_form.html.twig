{{ form_start(form) }}
    <div class="row">
        <div class="col">
            {{ form_row(form.name) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.description) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.startingDate) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.endingDate) }}
        </div>
    </div>
    <div class="row">
        <div class="col">
            {{ form_row(form.pendingFiles) }}
        </div>
    </div>
    {% if form.state is defined %}
        <div class="row">
            <div class="col">
                {{ form_row(form.state) }}
            </div>
        </div>
    {% endif %}
    <a class="btn btn-secondary" href="{{ path('app_project_show', {'id' : task.project.id}) }}">Retour au projet</a>
    <button class="btn btn-primary">{{ button_label|default('Enregistrer') }}</button>
{{ form_end(form) }}

{% if task.id is not null %}
    <hr>
    {{ include('file/_file_list.html.twig', {'files': task.files}) }}
{% endif %}
