<form class="d-inline" method="post" action="{{ path('app_task_delete', {'id': task.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer la tâche ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ task.id) }}">
    <button class="{{ class|default('btn') }}">{{ text ?? '<i class="bi bi-trash text-danger"></i>' }}</button>
</form>
