{% extends 'base.html.twig' %}

{% block title %}Projet{% endblock %}

{% block body %}
    <h1>Projet</h1>

    <table class="table table-hover text-left">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ project.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ project.name }}</td>
            </tr>
            <tr>
                <th>Description</th>
                <td>{{ project.description }}</td>
            </tr>
            <tr>
                <th>Responsable</th>
                <td>{{ project.owner.email }}</td>
            </tr>
        </tbody>
    </table>

    <h1>Liste des tâches</h1>

    <table class="table table-hover table-striped align-middle">
        <thead class="text-center align-middle">
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Description</th>
            <th>Date de début</th>
            <th>Date de fin</th>
            <th>Etat</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% if is_granted('ROLE_ADMIN') or project.owner.id == app.user.id %}
            {% set tasks = project.tasks %}
        {% else %}
            {% set tasks = project.notRemovedtasks %}
        {% endif %}
        {% for task in tasks %}
            <tr>
                <td class="text-center">{{ task.id }}</td>
                <td class="text-center">{{ task.name }}</td>
                <td>{{ task.description }}</td>
                <td class="text-center">{{ task.startingDate ? task.startingDate|date('Y-m-d H:i:s') : '' }}</td>
                <td class="text-center">{{ task.endingDate ? task.endingDate|date('Y-m-d H:i:s') : '' }}</td>
                <td class="text-center">{{ task.stateLibelled }}</td>
                <td class="text-center col-2">
                    <a class="btn" href="{{ path('app_task_show', {'id': task.id}) }}"><i class="bi bi-eye"></i></a>
                    <a class="btn" href="{{ path('app_task_edit', {'id': task.id}) }}"><i class="bi bi-pencil"></i></a>
                    {% if not task.isRemoved %}
                        {{ include('task/_delete_form.html.twig', {'class': 'btn'}) }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="7">Aucune tâche</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
    {% if app.user in project.contributors %}
        <a href="{{ path('app_task_new', {'project_id': project.id}) }}">Ajouter une tâche</a>
    {% endif %}

    <h1>Liste des contributeurs</h1>

    <table class="table table-hover table-striped align-middle">
        <thead class="text-center align-middle">
        <tr>
            <th>Id</th>
            <th>Nom</th>
            <th>Prénom</th>
            <th>Email</th>
            <th>Actions</th>
        </tr>
        </thead>
        <tbody>
        {% for contributor in project.contributors %}
            <tr class="text-center">
                <td>{{ contributor.id }}</td>
                <td>{{ contributor.firstname }}</td>
                <td>{{ contributor.lastname }}</td>
                <td>{{ contributor.email }}</td>
                {% if project.owner.id != contributor.id and is_granted('edit', project) %}
                    <th>{% include 'project/contributor/_delete_form.html.twig' with {'contributor': contributor, 'class': 'btn'} %}</th>
                {% else %}
                    <th></th>
                {% endif %}
            </tr>
        {% else %}
            <tr>
                <td colspan="6">Aucun contributeur</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a type="button" class="btn btn-secondary" href="{{ path('app_project_index') }}">Retour à la liste</a>

    {% if is_granted('edit', project) %}
        <a type="button" class="btn btn-primary"  href="{{ path('app_project_edit', {'id': project.id}) }}">Mettre à jour</a>

        {{ include('project/_delete_form.html.twig', {'class': 'btn btn-danger', 'text': 'Supprimer'}) }}
    {% endif %}

{% endblock %}
