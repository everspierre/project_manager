{% extends 'base.html.twig' %}

{% block title %}Projets{% endblock %}

{% block body %}
    <h1>Liste des projets</h1>

    <table class="table table-hover text-center">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Description</th>
                <th>Nombre de tâches</th>
                <th>Nombre de collaborateurs</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for project in projects %}
            <tr>
                <td>{{ project.id }}</td>
                <td>{{ project.name }}</td>
                <td>{{ project.description }}</td>
                <td>{{ project.tasks|length }}</td>
                <td>{{ project.contributors|length }}</td>
                <td>
                    <a class="btn" href="{{ path('app_project_show', {'id': project.id}) }}"><i class="bi bi-eye"></i></a>
                    {% if is_granted('edit', project) %}
                        <a class="btn" href="{{ path('app_project_edit', {'id': project.id}) }}"><i class="bi bi-pencil"></i></a>
                        {{ include('project/_delete_form.html.twig', {'class': 'btn'}) }}
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">Aucun projet</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <div class="row">
        <div class="col">
            <a href="{{ path('app_project_new') }}">Créer un nouveau projet</a>
        </div>
        <div class="col">
            <div class="navigation">
                {{ knp_pagination_render(projects) }}
            </div>
        </div>
    </div>

{% endblock %}
