<form class="d-inline" method="post" action="{{ path('app_project_delete', {'id': project.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer le projet ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ project.id) }}">
    <button class="{{ class|default('btn') }}">{{ text ?? '<i class="bi bi-trash text-danger"></i>' }}</button>
</form>
