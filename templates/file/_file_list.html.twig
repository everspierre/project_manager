<h1><i class="bi bi-paperclip"></i> Documents joints ({{ files|length }})</h1>

<div class="list-group">
    {% for file in files %}
        <div class="list-group-item d-flex justify-content-between align-items-center">
            <div>
                {# Petit helper pour l'icône selon l'extension #}
                {% set extension = file.filename|split('.')|last|lower %}
                <i class="bi
                    {% if extension in ['jpg', 'jpeg', 'png'] %}bi-file-image
                    {% elseif extension == 'pdf' %}bi-file-pdf
                    {% else %}bi-file-alt{% endif %} text-muted mr-2">
                </i>

                <strong>{{ file.filename }}</strong>
                <span class="text-muted small ml-2">
                    ({{ (file.size / 1024)|number_format(1) }} KB)
                </span>
            </div>

            <div class="actions">
                {# Génère l'URL vers le fichier physique #}
                <a href="{{ vich_uploader_asset(file, 'file') }}"
                   class="btn btn-sm btn-outline-primary"
                   target="_blank"
                   download>
                    <i class="bi bi-download"></i> Télécharger
                </a>
                <form class="d-inline" method="post" action="{{ path('app_file_delete', {'id': file.id}) }}"
                      onsubmit="return confirm('Supprimer ce fichier ?');">
                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ file.id) }}">
                    <button class="btn btn-sm btn-outline-danger">
                        <i class="bi bi-trash"></i>
                    </button>
                </form>
            </div>
        </div>
    {% else %}
        <p class="text-muted italic">Aucun document n'a été ajouté.</p>
    {% endfor %}
</div>
