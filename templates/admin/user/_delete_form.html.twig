<form class="d-inline" method="post" action="{{ path('app_admin_user_delete', {'id': user.id}) }}" onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer l\'utilisateur ?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
    <button class="{{ class|default('btn') }}">{{ text ?? '<i class="bi bi-trash text-danger"></i>' }}</button>
</form>
